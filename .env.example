NODE_ENV=development
PORT=4000

# URL publique de l'API - utilisée pour construire les liens de vérification
# de reçu encodés dans les QR codes (voir receipt.service.js). En
# production, remplacer par le vrai domaine (ex: https://api.flexpay.gn).
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL - ledger + identité
DATABASE_URL="postgresql://user:password@localhost:5432/flexpay?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_too_in_production
JWT_REFRESH_EXPIRES_IN=30d

# JWT Admin - secret totalement distinct du JWT client, pour qu'un token
# émis pour un client ne puisse jamais être accepté sur une route admin.
JWT_ADMIN_SECRET=change_me_admin_secret_in_production
JWT_ADMIN_EXPIRES_IN=8h

# Clé de chiffrement symétrique (AES-256-GCM, voir src/utils/encryption.js)
# - doit faire exactement 32 octets en hexadécimal (64 caractères), ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_64_hex_chars_32_bytes_in_production

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Verrouillage de compte
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Fournisseur SMS : nimba_sms (Guinée, par défaut) ou twilio (expansion régionale)
SMS_PROVIDER=nimba_sms
NIMBA_SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Fournisseur de carte virtuelle - "mock" en dev (aucun partenaire réel
# choisi pour l'instant). Voir src/modules/virtualCard/providers/
CARD_PROVIDER=mock

# Stockage de fichiers - "local" en dev uniquement (disque du serveur).
# JAMAIS en production - brancher un backend S3-compatible avant tout
# déploiement réel (voir src/modules/files/storage/).
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Scan antivirus - "clamav" utilise le binaire clamscan réel (voir
# src/modules/files/scanProviders/). En développement local sans ClamAV
# installé, mettre "disabled". CLAMAV_CUSTOM_DB_PATH ne sert qu'en test
# (signature EICAR fictive, voir README) - laisser vide en production
# pour que ClamAV utilise sa vraie base (chargée par `freshclam`).
VIRUS_SCAN_PROVIDER=clamav
CLAMAV_CUSTOM_DB_PATH=
# true UNIQUEMENT en développement (poste sans ClamAV configuré) - reste
# sans effet en production, où un scan indisponible bloque toujours l'upload.
ALLOW_UNSCANNED_UPLOADS=true

# Logs et suivi d'erreurs - voir src/utils/logger.js. LOG_LEVEL contrôle
# le niveau minimal affiché (debug, info, warn, error). SENTRY_DSN est
# optionnel : laisser vide tant qu'aucun compte Sentry n'existe, le
# suivi d'erreurs distant reste alors simplement désactivé (aucun impact
# sur les logs locaux, toujours actifs).
LOG_LEVEL=info
SENTRY_DSN=
